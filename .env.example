# Production is the safe default. Readiness requires the complete Bubblewrap self-test.
DOCGUARD_ENV=production
DOCGUARD_DATABASE_URL=sqlite:////var/lib/docguard/docguard.db
DOCGUARD_STORAGE_ROOT=/var/lib/docguard/storage
DOCGUARD_MAXIMUM_UPLOAD_BYTES=26214400
DOCGUARD_ISOLATION_BACKEND=bubblewrap
DOCGUARD_WORKER_TIMEOUT_SECONDS=10
DOCGUARD_CDR_TIMEOUT_SECONDS=30
DOCGUARD_CDR_MAX_PAGES=100
DOCGUARD_CDR_MAX_WIDTH_POINTS=2000
DOCGUARD_CDR_MAX_HEIGHT_POINTS=2000
DOCGUARD_CDR_MAX_WIDTH_PIXELS=4200
DOCGUARD_CDR_MAX_HEIGHT_PIXELS=4200
DOCGUARD_CDR_MAX_PIXELS_PER_PAGE=16000000
DOCGUARD_CDR_MAX_TOTAL_PIXELS=80000000
DOCGUARD_CDR_MAX_RASTER_BYTES=240000000
DOCGUARD_CDR_MAX_OUTPUT_BYTES=67108864
DOCGUARD_WORKER_STDOUT_MAX_BYTES=262144
DOCGUARD_WORKER_STDERR_MAX_BYTES=65536
DOCGUARD_WORKER_MEMORY_LIMIT_BYTES=536870912
DOCGUARD_WORKER_FILE_SIZE_LIMIT_BYTES=67108864
DOCGUARD_WORKER_OPEN_FILES_LIMIT=64
DOCGUARD_WORKER_TASKS_LIMIT=32
DOCGUARD_WORKER_CPU_LIMIT_SECONDS=8
DOCGUARD_WORKER_TMPFS_BYTES=67108864
DOCGUARD_WORKER_SOURCE_ROOT=worker
DOCGUARD_WORKER_CONTRACT_ROOT=docguard_contract
DOCGUARD_WORKER_DEPENDENCY_ROOT=.worker-deps
DOCGUARD_BUBBLEWRAP_PATH=/usr/bin/bwrap
DOCGUARD_PRLIMIT_PATH=/usr/bin/prlimit
DOCGUARD_SYSTEMD_RUN_PATH=/usr/bin/systemd-run
DOCGUARD_ISOLATION_SELF_TEST_CACHE_SECONDS=60
DOCGUARD_LOG_LEVEL=INFO
DOCGUARD_ALLOW_UNSAFE_DEVELOPMENT_BACKEND=false
DOCGUARD_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
DOCGUARD_SESSION_INACTIVITY_LIFETIME_SECONDS=1800
DOCGUARD_SESSION_REFRESH_INTERVAL_SECONDS=300
DOCGUARD_SESSION_COOKIE_NAME=__Host-docguard_session
DOCGUARD_SESSION_COOKIE_SECURE=true
DOCGUARD_SESSION_COOKIE_SAMESITE=lax
DOCGUARD_CSRF_REQUIRED=true
DOCGUARD_LOGIN_ATTEMPTS_PER_MINUTE=5
DOCGUARD_LOGIN_ATTEMPTS_PER_HOUR=50
DOCGUARD_APPLICATION_ORIGIN=https://127.0.0.1:8000
DOCGUARD_TRUSTED_PROXY_IPS=127.0.0.1,::1
DOCGUARD_REQUIRE_ORIGIN_HEADER=true
DOCGUARD_UPLOADS_PER_OPERATOR_HOUR=60
DOCGUARD_CDR_REQUESTS_PER_OPERATOR_HOUR=20
DOCGUARD_ARTIFACT_DOWNLOADS_PER_OPERATOR_HOUR=200
DOCGUARD_EXPENSIVE_READS_PER_OPERATOR_MINUTE=300
DOCGUARD_SQLITE_BUSY_TIMEOUT_MS=5000
DOCGUARD_RECONCILIATION_STALE_SECONDS=900

# Generated fixtures only (never copy to production):
# DOCGUARD_ENV=development
# DOCGUARD_ISOLATION_BACKEND=unsafe-development
# DOCGUARD_ALLOW_UNSAFE_DEVELOPMENT_BACKEND=true
# DOCGUARD_APPLICATION_ORIGIN=http://127.0.0.1:8000
